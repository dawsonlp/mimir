# Chat Echo Server Configuration
# Copy to .env and fill in your values

# =============================================================================
# LLM Model Selection (provider:model format)
# =============================================================================
# Uncomment ONE of these to select the active model:

LLM_MODEL=ollama:llama3.2
# LLM_MODEL=anthropic:claude-sonnet-4-5
# LLM_MODEL=anthropic:claude-opus-4-5
# LLM_MODEL=anthropic:claude-haiku-4-5

# =============================================================================
# Provider Credentials (define all, only active one is used)
# =============================================================================

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI (future)
# OPENAI_API_KEY=sk-your-key-here

# =============================================================================
# Mimir Knowledge Store
# =============================================================================
MIMIR_BASE_URL=http://localhost:38000
MIMIR_TENANT_ID=1

# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
PORT=8001
